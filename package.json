{
  "name": "web-thu-chi",
  "version": "1.0.0",
  "private": true,
  "description": "Webtool quản lý thu chi tự động từ SePay (Cloudflare Workers + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply sepay-thuchi --local",
